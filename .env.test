# 测试环境不连接真实数据库。
NODE_ENV=test
DB_ENABLED=false
# 仅用于测试的 JWT 密钥，不得用于生产环境。
JWT_SECRET=test-only-secret-with-at-least-32-chars
# 测试环境关闭 Swagger 文档。
SWAGGER_ENABLED=false
# 测试环境关闭外部对象存储。
STORAGE_ENABLED=false
# 测试环境关闭微信能力。
WECHAT_ENABLED=false
# 测试环境使用较高的限流上限，避免测试请求被拦截。
THROTTLE_TTL=60000
THROTTLE_LIMIT=1000

# 测试专用 RSA 私钥，仅用于 E2E 密文链路测试。
AUTH_RSA_PRIVATE_
