# 应用运行环境。
NODE_ENV=development
# 云托管运行时端口。
PORT=3000
# 本地兼容端口配置。
APP_PORT=3000
# 允许访问 API 的前端来源，多个来源使用逗号分隔。
CORS_ORIGINS=http://localhost:5173

# 是否启用 MySQL 数据库连接。
DB_ENABLED=true
# MySQL 主机地址。
DB_HOST=127.0.0.1
# MySQL 端口。
DB_PORT=3306
# MySQL 登录用户名。
DB_USERNAME=root
# MySQL 登录密码，请替换为本地密码。
DB_PASSWORD=replace-with-local-password
# 业务数据库名称。
DB_DATABASE=scenic_booking

# JWT 签名密钥，请替换为随机生成且不少于 32 个字符的密钥。
JWT_SECRET=replace-with-a-random-secret-32chars
# 访问令牌有效期。
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
# 刷新令牌有效期。
JWT_REFRESH_TOKEN_EXPIRES_IN=7d

# Base64 编码的 PKCS#8 RSA 私钥 DER，用于解密管理员密码传输密文。
AUTH_RSA_PRIVATE_KEY=replace-with-base64-pkcs8-rsa-private-key

# 是否启用 Swagger 文档。
SWAGGER_ENABLED=true

# 是否启用腾讯云 COS 对象存储。
STORAGE_ENABLED=false
# COS 所在地域。
COS_REGION=ap-guangzhou
# COS 存储桶名称。
COS_BUCKET=replace-bucket
# COS 访问标识。
COS_SECRET_ID=replace-secret-id
# COS 访问密钥。
COS_SECRET_KEY=replace-secret-key

# 是否启用微信能力。
WECHAT_ENABLED=false
# 微信小程序 AppID。
WECHAT_APP_ID=replace-app-id
# 微信小程序 AppSecret。
WECHAT_APP_SECRET=replace-app-secret

# 限流时间窗口，单位为毫秒。
THROTTLE_TTL=60000
# 单个客户端在时间窗口内允许的最大请求数。
THROTTLE_LIMIT=100
